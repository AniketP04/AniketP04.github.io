<!doctype html>
<html>
  <head>
    {% include head.liquid %}

    <!-- Distill js -->
    <script src="{{ '/assets/js/distillpub/template.v2.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/distillpub/transforms.v2.js' | relative_url }}"></script>
    {% if page._styles %}
      <!-- Page/Post style -->
      <style type="text/css">
        {{ page._styles }}
      </style>
    {% endif %}
  </head>

  <d-front-matter>
    <script async type="text/json">
      {
            "title": "{{ page.title }}",
            "description": "{{ page.description }}",
            "published": "{{ page.date | date: '%B %d, %Y' }}",
            "authors": [
              {% for author in page.authors %}
              {
                "author": "{{ author.name }}",
                "authorURL": "{{ author.url }}",
                "affiliations": [
                  {
                    "name": "{{ author.affiliations.name }}",
                    "url": "{{ author.affiliations.url }}"
                  }
                ]
              }{% if forloop.last == false %},{% endif %}
              {% endfor %}
            ],
            "katex": {
              "delimiters": [
                {
                  "left": "$",
                  "right": "$",
                  "display": false
                },
                {
                  "left": "$$",
                  "right": "$$",
                  "display": true
                }
              ]
            }
          }
    </script>
  </d-front-matter>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="post distill">
      <d-title>
        <h1>{{ page.title }}</h1>
        <p>{{ page.description }}</p>
      </d-title>
      {% if page.authors %}
        <d-byline></d-byline>
      {% endif %}

      <d-article>
  {% if page.toc and page.toc.size > 0 %}

    <!-- TOC STYLE -->
    <style>
      d-contents nav {
        font-size: 0.9rem;
      }

      .toc-section {
        margin-bottom: 0.5rem;
      }

      .toc-header {
        display: flex;
        align-items: center;
        cursor: pointer;
        user-select: none;
        gap: 0.4rem;
      }

      .toc-toggle {
        width: 14px;
        display: inline-block;
        transition: transform 0.2s ease;
        font-size: 0.75rem;
      }

      .toc-toggle.open {
        transform: rotate(90deg);
      }

      .toc-link {
        text-decoration: none;
        color: inherit;
      }

      .toc-subsections {
        margin-top: 0.3rem;
        margin-left: 1rem;
        padding-left: 0.8rem;
        border-left: 1px solid #ccc;

        max-height: 0;
        overflow: hidden;
        transition: max-height 0.25s ease;
      }

      .toc-subsections.open {
        max-height: 500px;
      }

      .toc-subsections li {
        margin: 0.3rem 0;
      }

      .toc-subsections a {
        text-decoration: none;
        color: inherit;
        font-size: 0.82rem;
      }

      .toc-subsections a:hover,
      .toc-link:hover {
        color: #007acc;
      }
    </style>

    <d-contents>
      <nav class="l-text figcaption">
        <h3>Contents</h3>

        {% for section in page.toc %}
          <div class="toc-section">

            <!-- SECTION HEADER -->
            <div class="toc-header">

              {% if section.subsections %}
                <span class="toc-toggle">▶</span>
              {% else %}
                <span class="toc-toggle"></span>
              {% endif %}

              <a
                class="toc-link"
                href="#{{ section.name | slugify }}"
              >
                {{ section.name }}
              </a>
            </div>

            <!-- SUBSECTIONS -->
            {% if section.subsections %}
              <ul class="toc-subsections">
                {% for subsection in section.subsections %}
                  <li>
                    <a href="#{{ subsection.name | slugify }}">
                      {{ subsection.name }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

          </div>
        {% endfor %}
      </nav>
    </d-contents>

    <!-- TOC SCRIPT -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {

        const headers = document.querySelectorAll(".toc-header");

        headers.forEach(header => {

          const toggle = header.querySelector(".toc-toggle");
          const subsectionList =
            header.parentElement.querySelector(".toc-subsections");

          if (!subsectionList) return;

          header.addEventListener("click", function (e) {

            // prevent toggling when clicking actual link
            if (e.target.tagName.toLowerCase() === "a") {
              return;
            }

            subsectionList.classList.toggle("open");
            toggle.classList.toggle("open");
          });
        });
      });
    </script>

  {% elsif page.toc == true %}

    <d-contents>
      <nav class="l-text figcaption">
        <h3>Contents</h3>
        {% toc %}
      </nav>
    </d-contents>

  {% endif %}

  {{ content }}
</d-article>

      <d-appendix>
        <d-footnote-list></d-footnote-list>
        <d-citation-list></d-citation-list>
      </d-appendix>

      <d-bibliography src="{{ page.bibliography | prepend: '/assets/bibliography/' | relative_url }}"></d-bibliography>

      <d-article>
        {% if site.related_blog_posts and site.related_blog_posts.enabled %}
          {% if page.related_posts == null or page.related_posts %}
            {% include related_posts.liquid %}
          {% endif %}
        {% endif %}
        <br>
        <br>
        {% if site.disqus_shortname and page.disqus_comments %}{% include disqus.liquid %}{% endif %}
        {% if site.giscus.repo and page.giscus_comments %}
          {% include giscus.liquid %}
        {% endif %}
      </d-article>
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include distill_scripts.liquid %}
  </body>
</html>
