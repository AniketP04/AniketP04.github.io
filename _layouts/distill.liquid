<!doctype html>
<html>
  <head>
    {% include head.liquid %}

    <!-- Distill js -->
    <script src="{{ '/assets/js/distillpub/template.v2.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/distillpub/transforms.v2.js' | relative_url }}"></script>
    {% if page._styles %}
      <!-- Page/Post style -->
      <style type="text/css">
        {{ page._styles }}
      </style>
    {% endif %}
  </head>

  <d-front-matter>
    <script async type="text/json">
      {
            "title": "{{ page.title }}",
            "description": "{{ page.description }}",
            "published": "{{ page.date | date: '%B %d, %Y' }}",
            "authors": [
              {% for author in page.authors %}
              {
                "author": "{{ author.name }}",
                "authorURL": "{{ author.url }}",
                "affiliations": [
                  {
                    "name": "{{ author.affiliations.name }}",
                    "url": "{{ author.affiliations.url }}"
                  }
                ]
              }{% if forloop.last == false %},{% endif %}
              {% endfor %}
            ],
            "katex": {
              "delimiters": [
                {
                  "left": "$",
                  "right": "$",
                  "display": false
                },
                {
                  "left": "$$",
                  "right": "$$",
                  "display": true
                }
              ]
            }
          }
    </script>
  </d-front-matter>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="post distill">
      <d-title>
        <h1>{{ page.title }}</h1>
        <p>{{ page.description }}</p>
      </d-title>
      {% if page.authors %}
        <d-byline></d-byline>
      {% endif %}

      <d-article>

  {% if page.toc %}

    <d-contents>

      <nav class="l-text figcaption toc-wrapper">

        <h3>Contents</h3>

        {% toc %}

      </nav>

    </d-contents>

  {% endif %}

  {{ content }}

</d-article>

{% if page.citation %}
  {% include citation.liquid %}
{% endif %}

<!-- ========================= -->
<!-- CSS -->
<!-- ========================= -->

<style>

/* ========================= */
/* Sticky TOC */
/* ========================= */

d-contents {
  position: sticky;
  top: 80px;

  max-height: calc(100vh - 100px);
  overflow-y: auto;

  padding-right: 10px;

  scrollbar-width: thin;
}

/* Scrollbar */

d-contents::-webkit-scrollbar {
  width: 6px;
}

d-contents::-webkit-scrollbar-thumb {
  background: rgba(120, 120, 120, 0.4);
  border-radius: 10px;
}

/* ========================= */
/* TOC Styling */
/* ========================= */

.toc-wrapper ul {
  list-style: none;
  padding-left: 0;
  margin-left: 0;
}

.toc-wrapper li {
  margin: 4px 0;
}

/* Nested subsections */

.toc-wrapper li ul {
  margin-top: 4px;
  margin-bottom: 8px;
  padding-left: 18px;

  display: none;
}

/* Links */

.toc-wrapper a {
  text-decoration: none;
}

.toc-wrapper a:hover {
  opacity: 0.8;
}

/* ========================= */
/* TOC Item Layout */
/* ========================= */

.toc-item {
  display: flex;
  align-items: center;
}

/* Toggle button */

.toc-toggle {
  border: none;
  background: none;

  cursor: pointer;

  margin-right: 6px;
  padding: 0;

  font-size: 0.8rem;
  line-height: 1;

  user-select: none;
}

/* Open state */

.toc-open > ul {
  display: block !important;
}

</style>

<!-- ========================= -->
<!-- JavaScript -->
<!-- ========================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

  // Find all TOC list items
  const tocItems = document.querySelectorAll(".toc-wrapper li");

  tocItems.forEach((item) => {

    // Direct child UL only
    const subList = item.querySelector(":scope > ul");

    // Skip if no subsection
    if (!subList) return;

    // Direct child link
    const link = item.querySelector(":scope > a");

    if (!link) return;

    // Create wrapper div
    const wrapper = document.createElement("div");
    wrapper.classList.add("toc-item");

    // Create toggle button
    const toggle = document.createElement("button");

    toggle.classList.add("toc-toggle");
    toggle.setAttribute("aria-expanded", "false");

    toggle.innerHTML = "▸";

    // Replace link with wrapper
    item.insertBefore(wrapper, link);

    wrapper.appendChild(toggle);
    wrapper.appendChild(link);

    // Toggle behavior
    toggle.addEventListener("click", function (e) {

      e.preventDefault();
      e.stopPropagation();

      const isOpen = item.classList.contains("toc-open");

      item.classList.toggle("toc-open");

      toggle.innerHTML = isOpen ? "▸" : "▾";

      toggle.setAttribute(
        "aria-expanded",
        !isOpen
      );

    });

  });

});

</script>

      <d-appendix>
        <d-footnote-list></d-footnote-list>
        <d-citation-list></d-citation-list>
      </d-appendix>

      <d-bibliography src="{{ page.bibliography | prepend: '/assets/bibliography/' | relative_url }}"></d-bibliography>

      <d-article>
        {% if site.related_blog_posts and site.related_blog_posts.enabled %}
          {% if page.related_posts == null or page.related_posts %}
            {% include related_posts.liquid %}
          {% endif %}
        {% endif %}
        <br>
        <br>
        {% if site.disqus_shortname and page.disqus_comments %}{% include disqus.liquid %}{% endif %}
        {% if site.giscus.repo and page.giscus_comments %}
          {% include giscus.liquid %}
        {% endif %}
      </d-article>
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include distill_scripts.liquid %}
  </body>
</html>
