<!doctype html>
<html>
  <head>
    {% include head.liquid %}

    <!-- Distill js -->
    <script src="{{ '/assets/js/distillpub/template.v2.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/distillpub/transforms.v2.js' | relative_url }}"></script>
    {% if page._styles %}
      <!-- Page/Post style -->
      <style type="text/css">
        {{ page._styles }}
      </style>
    {% endif %}
  </head>

  <d-front-matter>
    <script async type="text/json">
      {
            "title": "{{ page.title }}",
            "description": "{{ page.description }}",
            "published": "{{ page.date | date: '%B %d, %Y' }}",
            "authors": [
              {% for author in page.authors %}
              {
                "author": "{{ author.name }}",
                "authorURL": "{{ author.url }}",
                "affiliations": [
                  {
                    "name": "{{ author.affiliations.name }}",
                    "url": "{{ author.affiliations.url }}"
                  }
                ]
              }{% if forloop.last == false %},{% endif %}
              {% endfor %}
            ],
            "katex": {
              "delimiters": [
                {
                  "left": "$",
                  "right": "$",
                  "display": false
                },
                {
                  "left": "$$",
                  "right": "$$",
                  "display": true
                }
              ]
            }
          }
    </script>
  </d-front-matter>

  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="post distill">
      <d-title>
        <h1>{{ page.title }}</h1>
        <p>{{ page.description }}</p>
      </d-title>
      {% if page.authors %}
        <d-byline></d-byline>
      {% endif %}

      <d-article>
  {% if page.toc and page.toc.size > 0 %}

    <d-contents>

      <!-- Added toc-wrapper class -->
      <nav class="l-text figcaption toc-wrapper">

        <h3>Contents</h3>

        {% for section in page.toc %}

          <!-- Section -->
          <div class="toc-section">

            <div class="toc-item">

              <a href="#{{ section.name | slugify }}">
                {{ section.name }}
              </a>

            </div>

            <!-- Subsections -->
            {% if section.subsections %}

              <ul class="toc-subsections">

                {% for subsection in section.subsections %}

                  <li>
                    <a href="#{{ subsection.name | slugify }}">
                      {{ subsection.name }}
                    </a>
                  </li>

                {% endfor %}

              </ul>

            {% endif %}

          </div>

        {% endfor %}

      </nav>

    </d-contents>

  {% elsif page.toc == true %}

    <d-contents>
      <nav class="l-text figcaption toc-wrapper">

        <h3>Contents</h3>

        {% toc %}

      </nav>
    </d-contents>

  {% endif %}

  {{ content }}

</d-article>



<!-- ========================= -->
<!-- CSS -->
<!-- ========================= -->

<style>

/* ========================= */
/* Sticky TOC */
/* ========================= */

d-contents {
  position: sticky;
  top: 80px;

  max-height: calc(100vh - 100px);
  overflow-y: auto;

  padding-right: 10px;

  scrollbar-width: thin;
}

/* Optional nicer scrollbar */

d-contents::-webkit-scrollbar {
  width: 6px;
}

d-contents::-webkit-scrollbar-thumb {
  background: rgba(120, 120, 120, 0.4);
  border-radius: 10px;
}

/* ========================= */
/* TOC dropdown arrow */
/* ========================= */

.toc-toggle {
  cursor: pointer;
  margin-right: 6px;
  font-size: 0.8rem;
  user-select: none;
  display: inline-block;
  width: 12px;
}

/* Section title */

.has-submenu > a {
  font-weight: 600;
}

/* Subsection spacing */

.toc-subsections {
  margin-top: 4px;
  margin-bottom: 8px;
  padding-left: 18px;
}

/* Subsection links */

.toc-subsections li {
  margin: 4px 0;
}

.toc-subsections a {
  text-decoration: none;
}

/* Hover */

.toc-wrapper a:hover {
  opacity: 0.8;
}

</style>



<!-- ========================= -->
<!-- JavaScript -->
<!-- ========================= -->

<script>

document.addEventListener("DOMContentLoaded", function () {

  // Find all sections
  const tocSections = document.querySelectorAll(".toc-section");

  tocSections.forEach((section) => {

    // Find subsection list
    const subList = section.querySelector(".toc-subsections");

    // Only apply dropdown if subsection exists
    if (subList) {

      const tocItem = section.querySelector(".toc-item");

      // Add class
      tocItem.classList.add("has-submenu");

      // Create dropdown arrow
      const toggle = document.createElement("span");

      toggle.classList.add("toc-toggle");

      // Closed by default
      toggle.innerHTML = "▸";

      // Insert arrow before section link
      tocItem.insertBefore(toggle, tocItem.querySelector("a"));

      // Hide subsection initially
      subList.style.display = "none";

      // Toggle open/close
      toggle.addEventListener("click", function (e) {

        e.stopPropagation();

        const isOpen = getComputedStyle(subList).display !== "none";

        subList.style.display = isOpen ? "none" : "block";

        toggle.innerHTML = isOpen ? "▸" : "▾";

      });

    }

  });

});

</script>

      <d-appendix>
        <d-footnote-list></d-footnote-list>
        <d-citation-list></d-citation-list>
      </d-appendix>

      <d-bibliography src="{{ page.bibliography | prepend: '/assets/bibliography/' | relative_url }}"></d-bibliography>

      <d-article>
        {% if site.related_blog_posts and site.related_blog_posts.enabled %}
          {% if page.related_posts == null or page.related_posts %}
            {% include related_posts.liquid %}
          {% endif %}
        {% endif %}
        <br>
        <br>
        {% if site.disqus_shortname and page.disqus_comments %}{% include disqus.liquid %}{% endif %}
        {% if site.giscus.repo and page.giscus_comments %}
          {% include giscus.liquid %}
        {% endif %}
      </d-article>
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include distill_scripts.liquid %}
  </body>
</html>
